{
  "info": {
    "name": "Grub-Grab API",
    "description": "Full API collection for Grub-Grab Smart Restaurant Ordering Platform.\n\nWorkflow:\n1. Run 'Setup → Create First Admin' (once only)\n2. Run 'Admin → Login' — token auto-saved\n3. Run 'Admin → Categories' to add categories\n4. Run 'Admin → Menu Items' to add items\n5. Run 'Orders → Place Order' as a customer\n6. Run 'Delivery → Login' — token auto-saved",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",       "value": "http://localhost:5000" },
    { "key": "adminToken",    "value": "" },
    { "key": "deliveryToken", "value": "" }
  ],
  "item": [

    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },

    {
      "name": "Setup",
      "item": [
        {
          "name": "Create First Admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/setup/admin",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Super Admin\",\n  \"email\": \"admin@grubgrab.com\",\n  \"password\": \"Admin@123\",\n  \"phoneNumber\": \"03000000000\"\n}"
            }
          }
        }
      ]
    },

    {
      "name": "Menu (Public)",
      "item": [
        {
          "name": "Get All Active Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/menu/categories"
          }
        },
        {
          "name": "Get All Available Items",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/menu/items"
          }
        },
        {
          "name": "Search Items",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/menu/items/search?q=burger",
              "query": [{ "key": "q", "value": "burger" }]
            }
          }
        },
        {
          "name": "Items by Category",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/menu/items/1"
          }
        }
      ]
    },

    {
      "name": "Orders (Public)",
      "item": [
        {
          "name": "Place Order",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/orders",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Ahmed Khan\",\n  \"customerPhone\": \"03211234567\",\n  \"deliveryAddress\": \"House 10, Street 5, DHA Phase 4\",\n  \"deliveryCity\": \"Lahore\",\n  \"paymentMethod\": \"Cash on Delivery\",\n  \"specialInstructions\": \"Ring the bell twice\",\n  \"items\": [\n    { \"menuItemId\": 1, \"quantity\": 2 },\n    { \"menuItemId\": 5, \"quantity\": 1 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/1"
          }
        },
        {
          "name": "Order History by Phone",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/orders/history?phone=03211234567",
              "query": [{ "key": "phone", "value": "03211234567" }]
            }
          }
        }
      ]
    },

    {
      "name": "Admin",
      "item": [

        {
          "name": "Auth",
          "item": [
            {
              "name": "Admin Login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.success) {",
                      "  pm.collectionVariables.set('adminToken', res.data.token);",
                      "  console.log('Admin token saved.');",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/admin/login",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phoneNumber\": \"03000000000\",\n  \"password\": \"Admin@123\"\n}"
                }
              }
            }
          ]
        },

        {
          "name": "Orders",
          "item": [
            {
              "name": "Get All Orders",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/admin/orders",
                "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
              }
            },
            {
              "name": "Get All Orders (Filtered by Status)",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/admin/orders?status=Pending",
                  "query": [{ "key": "status", "value": "Pending" }]
                },
                "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
              }
            },
            {
              "name": "Get Order Detail",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/admin/orders/1",
                "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
              }
            },
            {
              "name": "Update Order Status",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/api/admin/orders/1/status",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" },
                  { "key": "Content-Type",   "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"Confirmed\"\n}"
                }
              }
            },
            {
              "name": "Assign Delivery Person",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/api/admin/orders/1/assign",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" },
                  { "key": "Content-Type",   "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"deliveryPersonId\": 2\n}"
                }
              }
            }
          ]
        },

        {
          "name": "Menu Items",
          "item": [
            {
              "name": "Get All Menu Items (Admin)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/admin/menu",
                "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
              }
            },
            {
              "name": "Add Menu Item",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/admin/menu",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" },
                  { "key": "Content-Type",   "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"categoryId\": 1,\n  \"itemName\": \"Spicy Chicken Burger\",\n  \"description\": \"Extra-hot crispy chicken with ghost pepper sauce\",\n  \"price\": 480,\n  \"isVegetarian\": false,\n  \"preparationTime\": 13\n}"
                }
              }
            },
            {
              "name": "Update Menu Item",
              "request": {
                "method": "PUT",
                "url": "{{baseUrl}}/api/admin/menu/1",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" },
                  { "key": "Content-Type",   "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"categoryId\": 1,\n  \"itemName\": \"Classic Beef Burger\",\n  \"description\": \"Juicy beef patty with lettuce, tomato and our signature sauce\",\n  \"price\": 380,\n  \"isAvailable\": true,\n  \"isVegetarian\": false,\n  \"preparationTime\": 12\n}"
                }
              }
            },
            {
              "name": "Delete Menu Item (Soft)",
              "request": {
                "method": "DELETE",
                "url": "{{baseUrl}}/api/admin/menu/1",
                "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
              }
            }
          ]
        },

        {
          "name": "Categories",
          "item": [
            {
              "name": "Get All Categories (Admin)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/admin/categories",
                "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
              }
            },
            {
              "name": "Add Category",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/admin/categories",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" },
                  { "key": "Content-Type",   "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"categoryName\": \"Sides\",\n  \"description\": \"Fries, wings and other sides\",\n  \"displayOrder\": 7\n}"
                }
              }
            },
            {
              "name": "Update Category",
              "request": {
                "method": "PUT",
                "url": "{{baseUrl}}/api/admin/categories/1",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" },
                  { "key": "Content-Type",   "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"categoryName\": \"Burgers\",\n  \"description\": \"Hand-crafted beef and chicken burgers\",\n  \"displayOrder\": 1,\n  \"isActive\": true\n}"
                }
              }
            },
            {
              "name": "Delete Category (Soft)",
              "request": {
                "method": "DELETE",
                "url": "{{baseUrl}}/api/admin/categories/7",
                "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
              }
            }
          ]
        },

        {
          "name": "Users",
          "item": [
            {
              "name": "Get Delivery Persons",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/admin/delivery-persons",
                "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
              }
            },
            {
              "name": "Create Delivery Person",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/admin/users/delivery-person",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" },
                  { "key": "Content-Type",   "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fullName\": \"Bilal Ahmed\",\n  \"phoneNumber\": \"03331234567\",\n  \"password\": \"delivery@456\",\n  \"address\": \"Flat 3, Model Town\",\n  \"city\": \"Lahore\",\n  \"vehicleType\": \"Motorcycle\",\n  \"vehicleNumber\": \"LHR-5678\"\n}"
                }
              }
            },
            {
              "name": "Activate / Deactivate User",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/api/admin/users/2/status",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" },
                  { "key": "Content-Type",   "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"isActive\": false\n}"
                }
              }
            }
          ]
        },

        {
          "name": "Stats",
          "item": [
            {
              "name": "Get Stats",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/admin/stats",
                "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
              }
            }
          ]
        }

      ]
    },

    {
      "name": "Delivery",
      "item": [
        {
          "name": "Delivery Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success) {",
                  "  pm.collectionVariables.set('deliveryToken', res.data.token);",
                  "  console.log('Delivery token saved.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/delivery/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"03001234567\",\n  \"password\": \"delivery@123\"\n}"
            }
          }
        },
        {
          "name": "Get Assigned Orders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/delivery/orders",
            "header": [{ "key": "Authorization", "value": "Bearer {{deliveryToken}}" }]
          }
        },
        {
          "name": "Get Active Deliveries",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/delivery/orders/active",
            "header": [{ "key": "Authorization", "value": "Bearer {{deliveryToken}}" }]
          }
        },
        {
          "name": "Update Delivery Status",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/delivery/orders/1/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{deliveryToken}}" },
              { "key": "Content-Type",   "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Out for Delivery\"\n}"
            }
          }
        }
      ]
    }

  ]
}
