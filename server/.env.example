# Server
PORT=5000
CLIENT_URL=http://localhost:3000

# ─── SQL Server Connection ───────────────────────────────────────
# DB_SERVER: hostname, IP, or named instance (e.g. .\SQLEXPRESS or myserver.database.windows.net)
DB_SERVER=.\SQLEXPRESS
DB_DATABASE=Grub
DB_PORT=1433                  # optional — defaults to 1433

# ─── Authentication ──────────────────────────────────────────────
# Leave DB_USER and DB_PASSWORD unset  → Windows Authentication (local dev)
# Set both                             → SQL Authentication      (cloud/prod)
# DB_USER=sa
# DB_PASSWORD=your_password_here

# ─── SSL / TLS ───────────────────────────────────────────────────
DB_ENCRYPT=false              # true  for Azure SQL / cloud (requires TLS)
DB_TRUST_CERT=true            # false for production with a valid certificate

# ─── Pool tuning (optional) ──────────────────────────────────────
DB_POOL_MAX=10
DB_POOL_IDLE=30000            # ms before idle connection is released
DB_CONN_TIMEOUT=15000         # ms to wait for a new connection
DB_REQUEST_TIMEOUT=15000      # ms to wait for a query result

# ─── Auth ────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production

# ─── Cloud examples (uncomment when deploying) ───────────────────
# DB_SERVER=myserver.database.windows.net
# DB_DATABASE=GrubProd
# DB_USER=sqladmin
# DB_PASSWORD=StrongPassword123!
# DB_ENCRYPT=true
# DB_TRUST_CERT=false
